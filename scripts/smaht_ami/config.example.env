# SMaHT Tibanna AMI build config, one file per AWS account.
#
# Copy to <account>.env in this folder and fill in. Files named *.env here are
# gitignored: the real values (IDs) must NOT be committed.

AWS_REGION=us-east-1

# HMS IT golden images shared with this account are named <prefix>-YYYY-MM-DD.
# The newest available x86_64 one is used unless --ami is given.
GOLDEN_AMI_NAME_PREFIX=srce-rhel9-golden
# Account that owns IT's golden images. Any account can share an AMI with this one, so only
# images owned by this account are used. Find it with:
#   aws ec2 describe-images --image-ids <a golden image id> --query 'Images[0].OwnerId' --output text
GOLDEN_AMI_OWNER=<account-id>

# Where the throwaway builder and boot-test instances run. They get no public IP, so the
# subnet must reach SSM and https://download.docker.com through a NAT gateway or endpoints.
SUBNET_ID=<subnet-id>
SECURITY_GROUP_ID=<security-group-id>     # needs outbound HTTPS only

# Instance profile with SSM access (AmazonSSMManagedInstanceCore). Nothing else is needed.
INSTANCE_PROFILE=<instance-profile-name>

# Optional
# INSTANCE_TYPE=c5a.large                 # builder and boot-test instance type
# AMI_NAME_PREFIX=tibanna-smaht-rhel9     # new AMI is <AMI_NAME_PREFIX>-<golden image date>
# TIBANNA_ROOT_EBS_SIZE=15                # root volume (GiB) the deployed Tibanna requests:
                                          # DEFAULT_ROOT_EBS_SIZE in tibanna_smaht/vars.py. A larger
                                          # golden root volume blocks --activate
# EXPECTED_AMI_KMS_KEY=<key-id-or-arn>    # what Tibanna is deployed with as AMI_KMS_KEY_ID; if the
                                          # snapshot uses another key: warning, and --activate stops
# EXTRA_TAGS=(Owner=<team> "Project=<x>") # bash array of Key=Value, added to every instance, volume,
                                          # AMI and snapshot (e.g. tags required by account policies)

# Only for --activate: the deployed start_run Lambda, whose AMI_ID is set to the new AMI.
# Named start_run_tiger[_<usergroup>][_<suffix>] (see the Lambda console)
# START_RUN_FUNCTION=start_run_tiger_<usergroup>
